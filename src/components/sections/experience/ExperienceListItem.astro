---
import type { jobSchema } from "@/content/config";
import type { z } from "astro:content";

type ExperienceItemType = z.infer<typeof jobSchema>;

type ExperienceItem = Pick<
  ExperienceItemType,
  "title" | "company" | "description" | "responsibilities" | "isActive"
>;

interface Props extends ExperienceItem {
  period: string;
}

const {
  title,
  company,
  period,
  description,
  responsibilities,
  isActive = false,
} = Astro.props;

const circleBgClass = isActive ? "bg-primary" : "bg-stone-400";
---

<div class="relative">
  <span
    class={`absolute -left-10.5 md:-left-14.5 top-1 w-5 h-5 rounded-full ${circleBgClass} border-4 border-white shadow-md`}
  ></span>
  <h4 class="text-xl font-bold">{title}</h4>
  <h5 class="text-primary font-medium mb-2">
    {company} | {period}
  </h5>
  <p class="text-muted mb-4 leading-relaxed">
    {description}
  </p>
  <ul
    class="list-disc list-inside text-muted space-y-1 text-sm marker:text-primary"
  >
    {responsibilities.map((item) => <li>{item}</li>)}
  </ul>
</div>
