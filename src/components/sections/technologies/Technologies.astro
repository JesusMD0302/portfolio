---
import { Server, Monitor, Cog } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import SectionTitle from "../title/SectionTitle.astro";
import TechnologyCard from "./TechnologyCard.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="habilidades" class="py-24 px-6 relative">
  <div class="max-w-6xl mx-auto">
    <SectionTitle title={t("home.sections.technologies")} number="01" />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Backend Card -->
      <TechnologyCard
        title={t("home.skills.backend.title")}
        description={t("home.skills.backend.description")}
        technologies={["Node.js", "PHP", "MongoDB", "MySQL", "PostgreSQL"]}
      >
        <Server />
      </TechnologyCard>

      <!-- Frontend Card -->
      <TechnologyCard
        color="rose"
        title={t("home.skills.frontend.title")}
        description={t("home.skills.frontend.description")}
        technologies={[
          "React",
          "Next.js",
          "Astro",
          "HTML",
          "CSS",
          "TypeScript",
          "Tailwind CSS",
          "Chakra UI",
          "Figma",
        ]}><Monitor /></TechnologyCard
      >

      <!-- DevOps & Tools Card -->
      <TechnologyCard
        color="amber"
        title={t("home.skills.tools.title")}
        description={t("home.skills.tools.description")}
        technologies={["Git / GitHub", "Linux", "Agile / Scrum", "Jira"]}
        ><Cog /></TechnologyCard
      >
    </div>
  </div>
</section>
