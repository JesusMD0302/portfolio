---
import { getLangFromUrl } from "@/i18n/utils";
import NavItem from "./NavItem.astro";
import { navigationPaths } from "./navigation.config.ts";

const lang = getLangFromUrl(Astro.url);
---

<div
  class="hidden md:flex space-x-8 text-sm font-medium tracking-wide text-muted"
>
  {
    navigationPaths.map((item) => (
      <NavItem href={`${item.base}${lang}/${item.href}`} label={item.label} />
    ))
  }
</div>
